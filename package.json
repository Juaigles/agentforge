{
  "name": "agentforge",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Plataforma local para crear, gestionar y ejecutar sistemas de agentes de IA",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w web",
    "start": "npm run start -w server",
    "test": "npm run test -w server && npm run test -w web",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w web && tsc --noEmit -p e2e",
    "test:e2e": "npm run build && playwright test --project=chromium",
    "test:e2e:ui": "npm run build && playwright test --project=chromium --ui",
    "loadtest": "node scripts/loadtest.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "test:e2e:all": "npm run build && playwright test",
    "test:coverage": "npm run test:coverage -w server && npm run test:coverage -w web",
    "docs:api": "npm run docs:api -w server"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript-eslint": "^8.72.2"
  },
  "overrides": {
    "glob": "^14.0.4",
    "minimatch": "^11.0.5"
  }
}
